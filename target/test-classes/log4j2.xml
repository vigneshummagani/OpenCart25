<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="Info">
    
    <!-- Define custom properties -->
    <Properties>
        <Property name="basePath">./logs</Property>
    </Properties>

    <!-- Define appenders -->
    <Appenders>

        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <!-- Rolling File Appender -->
        <RollingFile name="File"
                     fileName="${basePath}/automation.log"
                     filePattern="${basePath}/automation-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <SizeBasedTriggeringPolicy size="5KB"/>
        </RollingFile>

    </Appenders>

    <!-- Define loggers -->
    <Loggers>
        <Root level="Debug">
          <!-- <AppenderRef ref="Console"/> -->
             <AppenderRef ref="File"/>
        </Root>
    </Loggers>

</Configuration>
<!--Log Levels - All < Trace < Debug < Info < Warn < Error < Fatal < Off
Appenders - where to generate logs (Console/File)
Loggers - what type of logs generate (All < Trace < Debug < Info < WarnI < Error < Fatal < Off)-->
